# Hack Club OAuth Configuration
# Get these from https://auth.hackclub.com/developer/apps
HACKCLUB_CLIENT_ID="your_client_id"
HACKCLUB_CLIENT_SECRET="your_client_secret"

# The redirect URI must match what you configured in the Hack Club app settings
# For local development:
HACKCLUB_REDIRECT_URI="http://localhost:5173/login/auth"

# For production, use your actual domain:
# HACKCLUB_REDIRECT_URI="https://yourdomain.com/login/auth"
